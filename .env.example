

NODE_ENV=development
# local | staging | production. MUST be set on every deployed environment:
# `local` echoes one-time codes in the API response instead of sending them,
# which is how you test without SMS credentials -- and a disaster anywhere else.
APP_ENV=local
# Server-side absolute base URL: links in emails and SMS, webhook callbacks.
APP_URL=http://localhost:3000
# postgresql://USER:PASSWORD@HOST:5432/DATABASE -- your own values go in .env, never here.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/careondeck
DATABASE_POOL_MAX=10

# --- Crypto ----------------------------------------------------------------
# 32-byte base64 key used for column-level encryption of sensitive PHI fields.
PHI_ENCRYPTION_KEY=
SESSION_SECRET=

# --- Firebase Auth (identity provider; Google + Apple OAuth ride on top) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Browser-visible config ------------------------------------------------
# Next.js exposes ONLY variables prefixed NEXT_PUBLIC_ to client code; anything
# else is undefined in the browser. These are all publishable keys -- safe to
# ship in the bundle, and restricted by referrer/origin in their own consoles.
# Everything below this block is server-only and must never gain the prefix.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Firebase web app config -- Google/Apple sign-in and FCM push tokens.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Web Push VAPID key, from Firebase console > Cloud Messaging > Web Push certs.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Stripe (billing: plans, credits, add-ons, bundles, invoices) -----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Typesense (marketplace search) ----------------------------------------
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=
TYPESENSE_SEARCH_ONLY_KEY=

# --- Telnyx (SMS, OTP, number lookup) --------------------------------------
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM_NUMBER=
TELNYX_WEBHOOK_PUBLIC_KEY=

# --- Email (Postmark = transactional, SES = bulk/fallback) -----------------
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_WEBHOOK_SECRET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# --- Amazon Rekognition (photo moderation) ---------------------------------
REKOGNITION_MIN_CONFIDENCE=80

# --- S3 (media assets: headshots, facility photos, report exports) ---------
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# --- Cloudinary (interim file storage: provider documents only, never patient data) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Maps + Address Autocomplete ------------------------------------
# Server key only; the browser key lives above as NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_KEY=

# --- NPPES NPI Registry (public API, no key) -------------------------------
NPPES_BASE_URL=https://npiregistry.cms.hhs.gov/api

# --- OpenDental (per-facility credentials live in DB; this is the base URL) -
OPENDENTAL_BASE_URL=

# --- Ops -------------------------------------------------------------------
LOG_LEVEL=info
INTERNAL_JOB_SECRET=
